# Copy to .env and fill in. Find the Supabase values under
# Project Settings > API in the Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the web build runs; the parent consent page lives here.
# localhost for development (the hosted pilot uses https://rowlytics.expo.app)
EXPO_PUBLIC_WEB_URL=http://localhost:8081
